# Copy this file to .env and fill in your values
# Never commit your actual .env file to GitHub

# Recommended: an OpenRouter key (https://openrouter.ai/keys). Used first if set.
OPENROUTER_API_KEY=

# Alternative: an OpenAI key, used if OPENROUTER_API_KEY is empty.
# (The old name GPT_KEY still works as a fallback.)
OPENAI_API_KEY=

# Optional: override the chat model (default: gpt-6-luna).
LLM_MODEL=
